# Copy to .env for local docker compose.
# Production must leave ALLOW_DRAFT_CONTENT unset or false.

POSTGRES_USER=tutor
POSTGRES_PASSWORD=tutor
POSTGRES_DB=yourtutor
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000

ALLOW_DRAFT_CONTENT=true
# Study/checkpoint/analytics routes (404 when false).
RESEARCH_MODULE=true
# Legal/quiet-hours profile in config/jurisdictions/<id>.yaml; unknown id stops startup.
JURISDICTION_PROFILE=default_strict
PILOT_ONBOARDING=true
PILOT_KEY=dev-pilot

LLM_PROVIDER=
LLM_MODEL_FAST=
LLM_MODEL_STRONG=
# Leave unset to run authored-content fallback (required for local/demo).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
OTP_FROM_EMAIL=noreply@localhost
TOKEN_PEPPER=dev-only-change-me
REVIEWER_ALLOWLIST=curriculum.lead,teacher.demo
OTEL_ENABLED=false

NEXT_PUBLIC_API_URL=http://localhost:8000
