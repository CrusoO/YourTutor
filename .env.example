# Copy to .env for LOCAL DEVELOPMENT ONLY. Never use these values in production.
# ALLOW_DRAFT_CONTENT, RESEARCH_MODULE, DEV_TOOLS and NEXT_PUBLIC_DEV_TOOLS are development-only
# switches: with APP_ENV=production the API refuses to start if any of them is on.

POSTGRES_USER=tutor
POSTGRES_PASSWORD=tutor
POSTGRES_DB=yourtutor
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000

# Development only: serves draft (unapproved) content.
ALLOW_DRAFT_CONTENT=true
# Development only: study/checkpoint/analytics routes (404 when false). Off in production.
RESEARCH_MODULE=true
# Legal/quiet-hours profile in config/jurisdictions/<id>.yaml; unknown id stops startup.
JURISDICTION_PROFILE=default_strict
# Preview tools (docs/UI_PREVIEW.md): /dev pages and GET /dev/scenarios. Development only; off by default.
DEV_TOOLS=false
NEXT_PUBLIC_DEV_TOOLS=false
# Phone preview: the PC LAN address of the web app, e.g. http://192.168.1.20:3000
CORS_EXTRA_ORIGINS=
PILOT_ONBOARDING=true
PILOT_KEY=dev-pilot

LLM_PROVIDER=
LLM_MODEL_FAST=
LLM_MODEL_STRONG=
# Leave unset to run authored-content fallback (required for local/demo).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
OTP_FROM_EMAIL=noreply@localhost
TOKEN_PEPPER=dev-only-change-me
REVIEWER_ALLOWLIST=curriculum.lead,teacher.demo
OTEL_ENABLED=false

NEXT_PUBLIC_API_URL=http://localhost:8000
