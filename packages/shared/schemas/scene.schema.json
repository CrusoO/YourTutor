        "correct": {
          "title": "Correct",
          "type": "boolean"
        },
        "feedback": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocalizedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "text",
        "correct"
      ],
      "title": "AskOption",
      "type": "object"
    },
    "Canvas": {
