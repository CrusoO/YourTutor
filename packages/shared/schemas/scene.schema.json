        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "w": {
          "exclusiveMinimum": 0,
          "title": "W",
          "type": "number"
        },
        "h": {
          "exclusiveMinimum": 0,
          "title": "H",
          "type": "number"
        }
      },
