    "PauseAndAsk": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "pause_and_ask",
          "title": "Kind",
          "type": "string"
        },
        "question": {
          "$ref": "#/$defs/LocalizedText"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/AskOption"
          },
          "minItems": 2,
          "title": "Options",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "question",
        "options"
      ],
      "title": "PauseAndAsk",
      "type": "object"
    },
    "SceneStep": {
      "additionalProperties": false,
      "properties": {
        "caption": {
          "$ref": "#/$defs/LocalizedText"
        },
        "actions": {
          "items": {
            "discriminator": {
              "mapping": {
                "draw_arrow": "#/$defs/DrawArrow",
                "draw_shape": "#/$defs/DrawShape",
                "highlight": "#/$defs/Highlight",
                "pause_and_ask": "#/$defs/PauseAndAsk",
                "write_text": "#/$defs/WriteText"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/WriteText"
              },
              {
                "$ref": "#/$defs/DrawShape"
              },
              {
                "$ref": "#/$defs/DrawArrow"
              },
              {
                "$ref": "#/$defs/Highlight"
              },
              {
                "$ref": "#/$defs/PauseAndAsk"
              }
            ]
          },
          "minItems": 1,
          "title": "Actions",
          "type": "array"
        }
      },
      "required": [
        "caption",
        "actions"
      ],
      "title": "SceneStep",
      "type": "object"
    },
