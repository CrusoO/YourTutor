      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "write_text",
          "title": "Kind",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "size": {
          "exclusiveMinimum": 0,
          "title": "Size",
          "type": "number"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "color": {
          "anyOf": [
            {
              "enum": [
                "ink",
                "muted",
                "red",
                "blue",
                "green"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        }
      },
      "required": [
        "kind",
        "x",
        "y",
        "size",
        "text"
      ],
      "title": "WriteText",
      "type": "object"
    }
