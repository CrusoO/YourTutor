  "additionalProperties": false,
  "properties": {
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "skill_id": {
      "minLength": 1,
      "title": "Skill Id",
      "type": "string"
    },
    "source_ref": {
      "title": "Source Ref",
      "type": "string"
    },
    "canvas": {
      "$ref": "#/$defs/Canvas"
    },
    "alt": {
      "$ref": "#/$defs/LocalizedText"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/SceneStep"
      },
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    }
  },
  "required": [
    "id",
    "skill_id",
    "source_ref",
    "alt",
    "steps"
  ],
  "title": "Scene",
  "type": "object"
}
