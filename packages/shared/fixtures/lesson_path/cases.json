        4
      ],
      "beats": [
        "predict",
        "explore",
        "explain_scene",
        "worked_example",
        "explore",
        "check"
      ],
      "order": "problem_first",
      "serve": [
        "predict",
        "explore",
        "explain_scene",
        "worked_example",
        "explore",
        "check"
      ]
    },
    {
      "name": "novice_one_prerequisite_below_4",
      "prerequisite_levels": [
        4,
        3
      ],
      "order": "worked_example_first",
