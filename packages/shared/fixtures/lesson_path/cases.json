{
  "name": "lesson_path",
  "description": "R38: problem-first when every prerequisite is at ladder level 4 or more, otherwise worked-example-first (the explore and scene beats before the first worked example are skipped; later beats stay). Beats keep their authored order; predict stays first and check last.",
  "beats": [
    "predict",
    "explore",
    "explain_scene",
    "worked_example",
    "check"
  ],
  "cases": [
