      "name": "ready_student_all_prerequisites_at_4",
      "prerequisite_levels": [
        4,
        5,
        7
      ],
      "order": "problem_first",
      "serve": [
        "predict",
        "explore",
        "explain_scene",
        "worked_example",
        "check"
      ]
    },
    {
