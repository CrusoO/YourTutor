# --- Dependencies (never send to Docker daemon) ---
node_modules/
**/node_modules/
.pnpm-store/
.npm/

# --- Next.js build artifacts ---
apps/web/.next/
apps/web/out/
apps/web/.vercel/
apps/web/.turbo/

# --- Python ---
apps/api/__pycache__/
apps/api/**/__pycache__/
**/__pycache__/
**/*.pyc
**/*.pyo
apps/api/.venv/
apps/api/venv/
apps/api/.pytest_cache/
apps/api/.mypy_cache/

# --- Secrets — NEVER bake into image ---
apps/api/.env
apps/web/.env.local
.env
.env.*

# --- Logs / temp ---
logs/
*.log
.DS_Store
Thumbs.db
