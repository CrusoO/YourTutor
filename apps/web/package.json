{
  "name": "yourtutor-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000 --hostname 127.0.0.1",
    "//dev:lan": "For testing on a phone over Wi-Fi only (docs/UI_PREVIEW.md section 4). Listens on every network interface: never use it on a shared or public network.",
    "dev:lan": "next dev --port 3000 --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:weight": "playwright test e2e/weight.spec.ts",
    "check:weight": "node scripts/check-weight.mjs",
    "test:ui": "playwright test e2e/scenarios.spec.ts e2e/lesson.spec.ts e2e/flow.spec.ts e2e/help.spec.ts e2e/policy.spec.ts e2e/guest.spec.ts e2e/offline.spec.ts e2e/staff.spec.ts e2e/shell.spec.ts e2e/refine.spec.ts e2e/teen.spec.ts e2e/paper.spec.ts e2e/brownie-landing.spec.ts"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.27",
    "@radix-ui/react-avatar": "^1.2.7",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-progress": "^1.1.17",
    "@radix-ui/react-scroll-area": "^1.3.0",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-tabs": "^1.1.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
